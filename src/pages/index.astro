---
import AmbientNetwork from '../components/AmbientNetwork';
import InteractiveSystems from '../components/InteractiveSystems';
import '../styles/global.css';

const projects = [
  {
    type: 'release infrastructure',
    title: 'Project Aerodactyl',
    description: 'An interactive release hub for custom ROM builds targeting the Nothing Phone (2a) and 2a Plus. The work turns device-side source changes into a clear handoff for people who actually flash the builds.',
    stack: 'React / TypeScript / Vite / Netlify',
    href: 'https://github.com/TwistedVision518/project-aerodactyl',
    live: 'https://project-aerodactyl.netlify.app',
    color: 'blue',
  },
  {
    type: 'custom ROM / device trees',
    title: 'Aerodactyl bring-up',
    description: 'Device, vendor, kernel, and framework work for Nothing Phone (2a) and 2a Plus. Recent contributions include powerhint tuning for smoother blur, charging control fixes, UDFPS behavior, haptics, and display transitions.',
    stack: 'AOSP / C++ / Java / Kotlin / Make',
    href: 'https://github.com/LunarisPacman/android_device_nothing_Aerodactyl',
    live: 'https://github.com/LunarisPacman/android_device_nothing_Aerodactyl-kernel',
    color: 'ochre',
  },
  {
    type: 'security tooling',
    title: 'L.I.E.S.',
    description: 'A real-time network traffic analyzer and threat detection system. It brings packet inspection, threat indicators, a live connection map, and PCAP export into one educational defensive tool.',
    stack: 'React / Flask / Socket.IO / Scapy',
    href: 'https://github.com/TwistedVision518/L.I.E.S',
    live: 'https://github.com/TwistedVision518/L.I.E.S#readme',
    color: 'red',
  },
  {
    type: 'AI application',
    title: 'Zenny',
    description: 'An AI recipe assistant that turns ingredients into meals, with pantry awareness, meal planning, nutrition, budgets, and substitutions. A playful product surface around a Gemini-backed workflow.',
    stack: 'Next.js / React / TypeScript / Flask',
    href: 'https://github.com/TwistedVision518/Zenny',
    live: 'https://twistedzenny.netlify.app',
    color: 'blue',
  },
  {
    type: 'Linux systems',
    title: 'Odysee',
    description: 'An automated Arch Linux install flow that packages the desktop, network, audio, Bluetooth, printer, and application setup into a repeatable script.',
    stack: 'Shell / Arch Linux / KDE',
    href: 'https://github.com/TwistedVision518/Odysee',
    live: 'https://github.com/TwistedVision518/Odysee#readme',
    color: 'green',
  },
  {
    type: 'CLI / API integration',
    title: 'TradingBot',
    description: 'A zero-dependency Binance Futures Testnet CLI with strict order validation, MARKET/LIMIT/STOP_MARKET support, request logging, and graceful API error handling.',
    stack: 'Python / REST / HMAC SHA256',
    href: 'https://github.com/TwistedVision518/TradingBot',
    live: 'https://github.com/TwistedVision518/TradingBot#readme',
    color: 'ochre',
  },
];

const skills = ['Android platform', 'AOSP & custom ROMs', 'Device trees', 'Kernel bring-up', 'Linux systems', 'Cybersecurity', 'C / C++ / Java', 'Kotlin / Python', 'TypeScript / React', 'Shell scripting', 'Git & GitHub', 'Netlify'];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Pranav Praveen is a custom ROM maintainer, Linux systems builder, and cybersecurity student building systems with personality." />
    <meta name="theme-color" content="#0B0E17" />
    <link rel="canonical" href="https://twistedvis-portfolio.netlify.app" />
    <meta property="og:title" content="Pranav Praveen / TwistedVis" />
    <meta property="og:description" content="Custom ROMs, Linux systems, and security tools from a builder who makes stubborn systems behave." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://twistedvis-portfolio.netlify.app" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://cdn.fontshare.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@700,800&f[]=general-sans@400,500,600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Pranav Praveen / TwistedVis</title>
  </head>
  <body>
    <div class="ambient-layer" aria-hidden="true"><AmbientNetwork client:load /></div>
    <header class="site-header">
      <a class="brand" href="#top"><span class="brand-mark">TV</span><span>TwistedVis</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">about</a>
        <a href="#work">work</a>
        <a href="#skills">stack</a>
        <a href="#contact">contact</a>
      </nav>
      <a class="header-status" href="https://github.com/TwistedVision518" target="_blank" rel="noreferrer"><i /> available on GitHub</a>
    </header>

    <main id="top">
      <section class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Pranav Praveen / Bengaluru → Pune</p>
          <h1 id="hero-title">I make<br /><em>stubborn</em><br />systems behave.</h1>
          <p class="hero-deck">Custom ROM maintainer. Linux systems builder. Cybersecurity student. I work close to the machine, then make the result feel human.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">Inspect the work <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="https://github.com/TwistedVision518" target="_blank" rel="noreferrer">open GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
          <div class="hero-visual-wrap">
          <div class="hero-visual-note note-top">systems with personality <span>✳</span></div>
          <div class="hero-visual">
            <div class="hero-visual-backdrop" />
            <p class="sr-only">Interactive system trace: device tree, kernel, power, display, and release layers.</p>
            <InteractiveSystems client:load />
          </div>
          <div class="hero-visual-note note-bottom"><span>01 / 05</span> route: source → user</div>
        </div>
        <div class="hero-footer"><span>Scroll to trace the system</span><span class="hero-footer-line" /><span>21 / final-year BCA</span></div>
      </section>

      <section class="intro section-shell" id="about" aria-labelledby="about-title">
        <div class="section-marker">About</div>
        <div class="intro-grid">
          <h2 id="about-title">Close to the metal,<br /><span>not far from the person.</span></h2>
          <div class="intro-body">
            <p>I’m Pranav, a final-year BCA student specialising in Cyber Security at Symbiosis SICSR, Pune. I’ve been building around Android, Linux, and open source long enough to care about the last 5%: the smoother animation, the cleaner release note, the script that gets someone from zero to working.</p>
            <p>My school years were at Delhi Public School Bangalore East. Outside the terminal, I’m interested in making technical systems legible, useful, and a little more alive.</p>
            <div class="education-line"><span class="mono">EDUCATION</span><strong>Symbiosis / BCA Cyber Security</strong><span>2023—2026</span></div>
            <div class="education-line"><span class="mono">SCHOOL</span><strong>Delhi Public School Bangalore East</strong><span>verified context</span></div>
          </div>
        </div>
      </section>

      <section class="work section-shell" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div class="section-marker">Experience &amp; Projects</div>
          <div><h2 id="work-title">One connected<br /><span>maintenance map.</span></h2><p>From internship work to release infrastructure, these are the systems I’ve spent time making more useful. Source links are the receipts.</p></div>
        </div>
        <div class="work-list">
          <article class="work-item work-item-featured">
            <div class="work-index">00</div>
            <div class="work-type"><span class="status-dot status-ochre" /> internship / May—July 2026</div>
            <div class="work-main"><h3>Leapcodes Private Limited</h3><p>Internship experience supplied in the project brief. Role and technology details were not available in the public GitHub research, so this entry stays intentionally concise.</p><span class="source-note">provided context / details to be added</span></div>
            <div class="work-side"><span class="mono">IN PROGRESS</span><span>experience</span></div>
          </article>
          {projects.map((project, index) => (
            <article class={`work-item work-item-${project.color}`}>
              <div class="work-index">{String(index + 1).padStart(2, '0')}</div>
              <div class="work-type"><span class={`status-dot status-${project.color}`} /> {project.type}</div>
              <div class="work-main"><h3>{project.title}</h3><p>{project.description}</p><div class="work-links"><a href={project.href} target="_blank" rel="noreferrer">source ↗</a><a href={project.live} target="_blank" rel="noreferrer">{project.live.includes('netlify') ? 'live site ↗' : 'read notes ↗'}</a></div></div>
              <div class="work-side"><span class="mono">{project.stack}</span><span>verified source</span></div>
            </article>
          ))}
        </div>
        <div class="org-strip"><span class="mono">MAINTAINER SIGNAL</span><p>Admin across <a href="https://github.com/LunarisPacman" target="_blank" rel="noreferrer">LunarisPacman</a>, <a href="https://github.com/Pixelify-AOSP" target="_blank" rel="noreferrer">Pixelify-AOSP</a>, <a href="https://github.com/Evox-Aerodactyl" target="_blank" rel="noreferrer">Evox-Aerodactyl</a>, and other Aerodactyl-focused orgs. 455 commits and 21 pull requests in the latest GitHub contribution year.</p></div>
      </section>

      <section class="stack section-shell" id="skills" aria-labelledby="skills-title">
        <div class="section-marker">The stack</div>
        <div class="stack-grid"><div><h2 id="skills-title">Tools for the<br /><span>whole machine.</span></h2><p>I move between platform code, shell scripts, interfaces, and the release layer when that’s what the system needs.</p></div><div class="skill-cloud">{skills.map((skill) => <span>{skill}</span>)}</div></div>
      </section>

      <section class="contact section-shell" id="contact" aria-labelledby="contact-title">
        <div class="contact-rule" />
        <div class="contact-grid"><div><div class="section-marker">Contact</div><h2 id="contact-title">Have a system<br /><em>worth tuning?</em></h2></div><div class="contact-copy"><p>Open source, platform work, Linux, security, interesting constraints. If there’s something worth understanding from the inside out, send it over.</p><a class="button button-primary" href="mailto:pranavpraveen0@gmail.com">Email Pranav <span aria-hidden="true">↗</span></a><div class="contact-links"><a href="https://github.com/TwistedVision518" target="_blank" rel="noreferrer">GitHub ↗</a><a href="https://instagram.com/pranavislost" target="_blank" rel="noreferrer">Instagram ↗</a><a href="https://pranavpraveen.netlify.app" target="_blank" rel="noreferrer">Previous site ↗</a></div></div></div>
      </section>
    </main>

    <footer class="site-footer"><span>© {new Date().getFullYear()} Pranav Praveen / TwistedVis</span><span>Built with Astro + React / systems with personality</span><a href="#top">back to top ↑</a></footer>
  </body>
</html>

<script>
  import Lenis from 'lenis';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    const lenis = new Lenis({ autoRaf: true, smoothWheel: true, anchors: true });
    document.addEventListener('astro:before-swap', () => lenis.destroy(), { once: true });
  }

  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) entry.target.classList.add('is-visible');
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.work-item, .intro-grid, .stack-grid, .contact-grid').forEach((element) => revealObserver.observe(element));
</script>
